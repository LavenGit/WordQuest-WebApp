
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WordQuest | Puzzle Game</title>

  <style>
    :root {
      --bg: #0f1025;
      --card: #1c1d3b;
      --primary: #a78bfa;
      --secondary: #38bdf8;
      --text: #f8fafc;
      --muted: #a1a1bd;
      --success: #4ade80;
      --danger: #fb7185;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: 'Segoe UI', Arial, sans-serif;
      background:
        radial-gradient(circle at 15% 10%, #39245d 0%, transparent 35%),
        radial-gradient(circle at 90% 85%, #163456 0%, transparent 35%),
        var(--bg);
      color: var(--text);
    }

    /* Navigation */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 7%;
      border-bottom: 1px solid #ffffff15;
      gap: 20px;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    nav a {
      color: var(--muted);
      text-decoration: none;
      font-weight: 500;
      transition: color .2s;
    }

    nav a:hover {
      color: white;
    }

    /* Main content */
    main {
      max-width: 1100px;
      margin: auto;
      padding: 55px 24px;
    }

    .hero {
      text-align: center;
      margin-bottom: 40px;
    }

    .eyebrow {
      color: var(--secondary);
      letter-spacing: 3px;
      font-weight: 700;
      font-size: .8rem;
    }

    h1 {
      font-size: clamp(2.3rem, 6vw, 4rem);
      margin: 15px 0;
    }

    h1 span {
      background: linear-gradient(90deg, #c084fc, #38bdf8);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .subtitle {
      color: var(--muted);
      font-size: 1.1rem;
    }

    /* Dashboard */
    .dashboard {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: #ffffff0b;
      border: 1px solid #ffffff20;
      border-radius: 18px;
      padding: 22px;
    }

    .stat-label {
      color: var(--muted);
      font-size: .85rem;
      margin-bottom: 10px;
    }

    .stat-value {
      font-size: 1.8rem;
      font-weight: 800;
    }

    .progress-track {
      height: 9px;
      background: #333453;
      border-radius: 20px;
      overflow: hidden;
      margin-top: 15px;
    }

    .progress-fill {
      width: 0%;
      height: 100%;
      background: linear-gradient(90deg, #a78bfa, #38bdf8);
      transition: width .5s ease;
    }

    /* Puzzle cards */
    .puzzle-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .puzzle {
      background: linear-gradient(155deg, #252647, #191a35);
      border: 1px solid #ffffff20;
      border-radius: 22px;
      padding: 26px 22px;
      text-align: center;
      transition: transform .25s, border-color .25s;
    }

    .puzzle:hover {
      transform: translateY(-5px);
      border-color: var(--primary);
    }

    .puzzle.solved {
      border-color: var(--success);
      background: linear-gradient(155deg, #1d3b38, #191a35);
    }

    .puzzle-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .level-label {
      font-size: .8rem;
      color: var(--muted);
    }

    .status {
      font-size: .75rem;
      color: var(--primary);
      background: #a78bfa20;
      padding: 6px 10px;
      border-radius: 30px;
    }

    .emoji {
      font-size: 2.8rem;
      margin-bottom: 16px;
    }

    .scrambledWord {
      font-size: clamp(1.4rem, 2.5vw, 2rem);
      font-weight: 800;
      letter-spacing: 4px;
      color: white;
      overflow-wrap: anywhere;
      margin-bottom: 14px;
    }

    .hint {
      color: var(--muted);
      font-size: .9rem;
      min-height: 42px;
    }

    .userInput {
      width: 100%;
      background: #11122a;
      border: 1px solid #424366;
      color: white;
      border-radius: 12px;
      padding: 13px;
      font-size: 1rem;
      text-align: center;
      outline: none;
      margin: 18px 0 8px;
      transition: border-color .2s;
    }

    .userInput:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px #a78bfa25;
    }

    .check-btn {
      width: 100%;
      padding: 13px;
      background: linear-gradient(90deg, #8b5cf6, #6366f1);
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: filter .2s, transform .2s;
    }

    .check-btn:hover:not(:disabled) {
      filter: brightness(1.2);
      transform: translateY(-2px);
    }

    .check-btn:disabled {
      background: #276749;
      cursor: default;
    }

    .result {
      min-height: 22px;
      font-size: .85rem;
      font-weight: 600;
      margin: 15px 0 0;
    }

    /* Bottom actions */
    .actions {
      text-align: center;
      margin-top: 35px;
    }

    .restart-btn {
      padding: 13px 28px;
      background: transparent;
      border: 1px solid #777897;
      border-radius: 12px;
      color: white;
      font-weight: 700;
      cursor: pointer;
    }

    .restart-btn:hover {
      background: #ffffff15;
    }

    .completion {
      display: none;
      text-align: center;
      padding: 35px;
      margin-top: 30px;
      background: #172d35;
      border: 1px solid var(--success);
      border-radius: 20px;
      animation: appear .5s ease;
    }

    .completion h2 {
      color: var(--success);
      font-size: 2rem;
    }

    .completion p {
      color: #d1d5db;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(15px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 850px) {
      .puzzle-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      header {
        flex-direction: column;
      }

      nav {
        justify-content: center;
      }

      main {
        padding: 35px 16px;
      }

      .dashboard,
      .puzzle-grid {
        grid-template-columns: 1fr;
      }
    }
    .leaderboard-link {
    display: inline-block;
    margin: 12px 8px;
    padding: 13px 22px;
    border-radius: 12px;
    background: linear-gradient(90deg, #8b5cf6, #6366f1);
    color: white;
    text-decoration: none;
    font-weight: 600;
    transition: 0.2s;
    }

    .leaderboard-link:hover {
    transform: translateY(-2px);
    filter: brightness(1.15);
    }

    #saveStatus {
    color: #a78bfa;
    margin-top: 15px;
    }
    
  </style>
</head>

<body>

  <header>
    <a href="/" class="logo">🧩 WordQuest</a>

    <nav>
      <a href="/">Home</a>
      <a href="/level2">Level 2</a>
      <a href="/title">Title</a>
      <a href="/login">Login</a>
      <a href="/jokes">Jokes</a>
      <a href="/leaderboard">🏆 Leaderboard</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="eyebrow">BRAIN TRAINING CHALLENGE</div>
      <h1>Unscramble. <span>Discover. Win.</span></h1>
      <p class="subtitle">
        Decode the hidden words, beat the clock, and become a word master.
      </p>
    </section>

    <section class="dashboard">
      <div class="stat-card">
        <div class="stat-label">⏱️ Time Elapsed</div>
        <div class="stat-value" id="timer">00:00</div>
      </div>

      <div class="stat-card">
        <div class="stat-label">🏆 Your Progress</div>
        <div class="stat-value" id="progressText">0 / 3 Solved</div>
        <div class="progress-track">
          <div class="progress-fill" id="progressFill"></div>
        </div>
      </div>
    </section>

    <section class="puzzle-grid" id="puzzleGrid"></section>


    <section class="completion" id="completion" aria-live="polite">
      <div style="font-size:3.5rem">🏆</div>

      <h2>Challenge Complete!</h2>

      <p id="finalMessage"></p>
      <p id="finalTime"></p>

      <p id="saveStatus" aria-live="polite"></p>

      <a href="/leaderboard" class="leaderboard-link">
        🏆 View Leaderboard
      </a>

      <a href="/level2" class="leaderboard-link">
        Continue to Level 2 →
      </a>
    </section>

    <div class="actions">
      <button class="restart-btn" id="restartBtn">
        ↻ Restart Challenge
      </button>
    </div>
  </main>

  <script>
    const puzzles = [
      {
        scrambled: "NUTDO",
        answer: "DONUT",
        hint: "Sweet circular treat",
        emoji: "🍩"
      },
      {
        scrambled: "YPTNOH",
        answer: "PYTHON",
        hint: "Popular programming language",
        emoji: "🐍"
      },
      {
        scrambled: "IEBRBA",
        answer: "BARBIE",
        hint: "Famous doll brand",
        emoji: "🎀"
      }
    ];

    let solved = [];
    let startTime;
    let timerInterval;
    let completed = false;

    const grid = document.getElementById("puzzleGrid");
    const timer = document.getElementById("timer");
    const progressText = document.getElementById("progressText");
    const progressFill = document.getElementById("progressFill");
    const completion = document.getElementById("completion");

    function renderPuzzles() {
      grid.innerHTML = "";

      puzzles.forEach((puzzle, index) => {
        const card = document.createElement("article");
        card.className = "puzzle";
        card.dataset.index = index;

        card.innerHTML = `
          <div class="puzzle-top">
            <span class="level-label">PUZZLE ${index + 1}</span>
            <span class="status">Unsolved</span>
          </div>

          <div class="emoji">${puzzle.emoji}</div>
          <div class="scrambledWord">${puzzle.scrambled}</div>
          <p class="hint">💡 ${puzzle.hint}</p>

          <form class="answer-form">
            <input
              class="userInput"
              type="text"
              placeholder="Type your answer..."
              autocomplete="off"
              aria-label="Answer for puzzle ${index + 1}"
              required
            >
            <button class="check-btn" type="submit">
              Check Answer →
            </button>
          </form>

          <p class="result" aria-live="polite"></p>
        `;

        card.querySelector("form").addEventListener("submit", (event) => {
          event.preventDefault();
          checkAnswer(index);
        });

        grid.appendChild(card);
      });
    }

    function getElapsedSeconds() {
      return Math.floor((Date.now() - startTime) / 1000);
    }

    function formatTime(totalSeconds) {
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;

      return String(minutes).padStart(2, "0") + ":" +
             String(seconds).padStart(2, "0");
    }

    function updateTimer() {
      timer.textContent = formatTime(getElapsedSeconds());
    }

    function updateProgress() {
      const count = solved.filter(Boolean).length;
      const percent = (count / puzzles.length) * 100;

      progressText.textContent = `${count} / ${puzzles.length} Solved`;
      progressFill.style.width = `${percent}%`;
    }

    function checkAnswer(index) {
      if (completed || solved[index]) return;

      const card = grid.querySelector(`[data-index="${index}"]`);
      const input = card.querySelector(".userInput");
      const result = card.querySelector(".result");
      const button = card.querySelector(".check-btn");
      const status = card.querySelector(".status");

      const answer = input.value.trim().toUpperCase();

      if (answer === puzzles[index].answer) {
        solved[index] = true;

        card.classList.add("solved");
        result.textContent = "🎉 Excellent! Correct answer.";
        result.style.color = "var(--success)";

        input.disabled = true;
        button.disabled = true;
        button.textContent = "✓ Completed";

        status.textContent = "Solved ✓";
        status.style.color = "var(--success)";

        updateProgress();

        if (solved.every(Boolean)) {
          finishGame();
        }
      } else {
        result.textContent = "❌ Not quite! Try again.";
        result.style.color = "var(--danger)";

        input.focus();
        input.select();
      }
    }
    
    async function submitScore(level, totalSeconds) {
        const saveStatus = document.getElementById("saveStatus");

        saveStatus.textContent = "Saving your score...";

        try {
            const response = await fetch("/api/scores", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "same-origin",
                body: JSON.stringify({
                    level: level,
                    completionTime: totalSeconds
                })
            });

            if (!response.ok) {
                throw new Error("Failed to save score");
            }

            const data = await response.json();

            if (data.success) {
                saveStatus.textContent =
                    "✅ Your score has been saved to the leaderboard!";
            }

        } catch (error) {
            console.error("Score submission error:", error);

            saveStatus.textContent =
            "❌ Could not save your score. Please try again later.";
        }
    }


    function finishGame() {
        if (completed) return;

        completed = true;

    // Stop the timer
        clearInterval(timerInterval);

    // Calculate total completion time
        const total = Math.max(1, getElapsedSeconds());

        timer.textContent = formatTime(total);

    // Display completion section
        completion.style.display = "block";

        document.getElementById("finalTime").textContent =
            `Your completion time: ${formatTime(total)}`;

        document.getElementById("finalMessage").textContent =
            total < 60
                ? "⚡ Speed Master! You finished in under one minute!"
                : "Amazing work! You solved every puzzle.";

        // NEW: Save Level 1 completion time
        submitScore(1, total);

        completion.scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });
    }


    function restartGame() {
      clearInterval(timerInterval);

      solved = Array(puzzles.length).fill(false);
      completed = false;

      completion.style.display = "none";

      renderPuzzles();
      updateProgress();

      startTime = Date.now();
      updateTimer();

      timerInterval = setInterval(updateTimer, 1000);
    }

    document.getElementById("restartBtn")
      .addEventListener("click", restartGame);

    restartGame();
  </script>

</body>
</html>
