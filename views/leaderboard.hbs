
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WordQuest | Leaderboard</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: linear-gradient(135deg, #101126, #222044, #171832);
    color: white;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 8%;
    border-bottom: 1px solid #ffffff20;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: #a78bfa;
    text-decoration: none;
}

nav a {
    color: #c4c4d8;
    text-decoration: none;
    margin-left: 24px;
}

nav a:hover {
    color: white;
}

.container {
    max-width: 950px;
    margin: 55px auto;
    padding: 0 20px;
}

.page-heading {
    text-align: center;
    margin-bottom: 35px;
}

.page-heading h1 {
    font-size: 38px;
    margin-bottom: 12px;
}

.page-heading p {
    color: #a1a1bd;
}

.leaderboard-card {
    background: #20213e;
    border: 1px solid #ffffff20;
    border-radius: 22px;
    padding: 30px;
    box-shadow: 0 15px 45px #00000040;
}

.level-buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 30px;
}

.level-btn {
    border: 1px solid #555577;
    background: #2c2d4e;
    color: white;
    padding: 12px 28px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 15px;
}

.level-btn.active {
    background: linear-gradient(90deg, #8b5cf6, #6366f1);
    border-color: transparent;
}

.table-header,
.player-row {
    display: grid;
    grid-template-columns: 80px 1fr 150px;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
}

.table-header {
    color: #a1a1bd;
    font-size: 13px;
    text-transform: uppercase;
}

.player-row {
    background: #2b2c4c;
    border-radius: 13px;
    margin-bottom: 12px;
}

.player-row.first {
    background: #44365c;
    border: 1px solid #fbbf2450;
}

.player-row.second {
    border: 1px solid #cbd5e140;
}

.player-row.third {
    border: 1px solid #d69e7540;
}

.rank {
    font-size: 22px;
    font-weight: bold;
}

.player-name {
    font-weight: 600;
    overflow-wrap: anywhere;
}

.player-time {
    font-weight: bold;
    text-align: right;
    color: #c4b5fd;
}

.empty-message {
    text-align: center;
    padding: 35px;
    color: #a1a1bd;
}

.status {
    text-align: center;
    color: #a1a1bd;
    margin-bottom: 20px;
}

@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    .leaderboard-card {
        padding: 16px;
    }

    .table-header,
    .player-row {
        grid-template-columns: 50px 1fr 90px;
        padding: 15px 10px;
    }

    .page-heading h1 {
        font-size: 29px;
    }
}
</style>
</head>

<body>

<header>
    <a href="/" class="logo">🧩 WordQuest</a>

    <nav>
        <a href="/">Home</a>
        <a href="/newpage">Level 1</a>
        <a href="/level2">Level 2</a>
    </nav>
</header>

<main class="container">

    <div class="page-heading">
        <h1>🏆 Player Leaderboard</h1>
        <p>See who's solving WordQuest puzzles the fastest!</p>
    </div>

    <section class="leaderboard-card">

        <div class="level-buttons">
            <button class="level-btn active"
                    data-level="1">
                Level 1
            </button>

            <button class="level-btn"
                    data-level="2">
                Level 2
            </button>
        </div>

        <div id="status" class="status" aria-live="polite">
            Loading rankings...
        </div>

        <div class="table-header">
            <span>Rank</span>
            <span>Player</span>
            <span style="text-align:right">Best Time</span>
        </div>

        <div id="playerList"></div>

    </section>

</main>

<script>
const playerList = document.getElementById("playerList");
const statusText = document.getElementById("status");
const buttons = document.querySelectorAll(".level-btn");

let currentLevel = 1;

function formatTime(seconds) {
    const minutes = Math.floor(seconds / 60);
    const remaining = seconds % 60;

    return String(minutes).padStart(2, "0") + ":" +
           String(remaining).padStart(2, "0");
}

async function loadLeaderboard(level) {
    currentLevel = level;
    statusText.textContent = "Loading rankings...";
    playerList.replaceChildren();

    buttons.forEach(button => {
        button.classList.toggle(
            "active",
            Number(button.dataset.level) === level
        );
    });

    try {
        const response = await fetch(
            `/api/leaderboard/${level}`
        );

        if (!response.ok) {
            throw new Error("Failed to load leaderboard");
        }

        const players = await response.json();

        statusText.textContent = "";

        if (players.length === 0) {
            const message = document.createElement("p");
            message.className = "empty-message";
            message.textContent =
                "No scores yet. Be the first to complete this level!";
            playerList.appendChild(message);
            return;
        }

        players.forEach(player => {
            const row = document.createElement("div");
            row.className = "player-row";

            if (player.rank === 1) row.classList.add("first");
            if (player.rank === 2) row.classList.add("second");
            if (player.rank === 3) row.classList.add("third");

            const rank = document.createElement("span");
            rank.className = "rank";

            const medals = {
                1: "🥇",
                2: "🥈",
                3: "🥉"
            };

            rank.textContent = medals[player.rank] || player.rank;

            const name = document.createElement("span");
            name.className = "player-name";
            name.textContent = player.username;

            const time = document.createElement("span");
            time.className = "player-time";
            time.textContent = formatTime(player.time);

            row.append(rank, name, time);
            playerList.appendChild(row);
        });

    } catch (error) {
        console.error(error);
        statusText.textContent =
            "Unable to load rankings. Please try again.";
    }
}

buttons.forEach(button => {
    button.addEventListener("click", () => {
        loadLeaderboard(Number(button.dataset.level));
    });
});

loadLeaderboard(currentLevel);
</script>

</body>
</html>
